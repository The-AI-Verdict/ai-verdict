# Copy this file to .env and fill in real values. Never commit .env.

# Required: OpenRouter API key used to call tested models AND the evaluator model.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Optional: shown to OpenRouter for their public leaderboard attribution only.
# Safe to leave as placeholders.
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=AI Verdict Experiment Lab

# Optional: path to the SQLite database file. Defaults to ./data/ai_verdict.db
AI_VERDICT_DB_PATH=./data/ai_verdict.db

# Optional: default model used as the independent evaluator (see core/evaluator.py).
# Should generally be a different model from whatever is under test.
AI_VERDICT_EVALUATOR_MODEL=openai/gpt-4.1-mini
